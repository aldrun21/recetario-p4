rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() < 128;
    }

    // Patients Collection Rules
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // Prescriptions Collection Rules
    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }

    // Doctor Profile Rules
    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    // Medications Catalog Rules
    match /medications_catalog/{medId} {
      allow read, write: if true;
    }

    // Custom Presets Rules
    match /custom_presets/{presetId} {
      allow read, write: if true;
    }
  }
}
